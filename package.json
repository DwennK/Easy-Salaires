{
  "name": "easy-salaires",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm check:data && vue-tsc --noEmit && vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:build-storage": "node --test scripts/build-desktop-check.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:ui": "node scripts/ui-test.mjs",
    "tauri": "tauri",
    "check": "pnpm check:data && pnpm typecheck && pnpm test && pnpm test:storage && pnpm build",
    "test:ux": "tsx scripts/ux-test.mjs",
    "test:v2": "node scripts/v2-ui-test.mjs",
    "test:updater": "node scripts/updater-ui-test.mjs",
    "check:data": "node scripts/check-data-compatibility.mjs",
    "test:storage": "node scripts/test-storage.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "lucide-vue-next": "0.468.0",
    "pdf-lib": "1.17.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
